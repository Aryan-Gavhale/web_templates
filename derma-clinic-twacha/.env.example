# Copy to .env and edit. Everything here is optional — the app runs without a
# .env file at all, using the defaults shown.

# ---------------------------------------------------------------- Google ----
# Enables live reviews and live clinic photographs. Without it the site shows
# clearly-labelled sample reviews and the admin panel says so on every screen
# that touches them.
#
#   1. Create a Google Cloud project.
#   2. Enable "Places API (New)".
#   3. Create an API key and restrict it to that one API.
#   4. Paste it below and restart the server.
#   5. In the admin panel, Settings → Find a Place ID, then save the ID against
#      each clinic under Clinics.
GOOGLE_MAPS_API_KEY=

# How long a Google response is reused before asking again. Google bills per
# request, and reviews do not change minute to minute.
GOOGLE_CACHE_MINUTES=360

# ---------------------------------------------------------------- server ----
PORT=5173

# Listen address. "::" accepts both IPv6 and IPv4, which matters because
# browsers resolve "localhost" to ::1 first. Use 127.0.0.1 to refuse anything
# but this machine.
HOST=::

# How many reverse proxies you control sit in front of this app. 0 means none,
# and X-Forwarded-For is ignored entirely.
#
# Set it to the real hop count — 1 for a single nginx or Caddy in front. It is a
# count rather than on/off because trusting the header outright would mean
# reading its left-most entry, which a client can prepend to even from behind
# your proxy. Rate limiting and the audit log both record the address this
# yields, so an over-generous value hands an attacker unlimited login attempts
# and a forgeable audit trail.
TRUST_PROXY=0

# Set to 1 when served over HTTPS, so the session cookie is marked Secure.
COOKIE_SECURE=0

# ------------------------------------------------------------------ clinic --
# Decides what "today" and "overdue" mean. Arrears must be judged in the
# clinic's own day, not the server's.
CLINIC_TZ=Asia/Kolkata

# ------------------------------------------------------------------- seed ---
# Used only by `npm run seed`, and only the first time it runs.
SEED_ADMIN_EMAIL=owner@twacha.in
SEED_ADMIN_PASSWORD=TwachaAdmin2026
